//@version=6
indicator("Gap Classifier & Trade Signals", overlay=true,
     max_labels_count=500, max_lines_count=500, max_boxes_count=200)

// ── INPUTS ────────────────────────────────────────────────────────────────────
var G_F = "Video Filters"
i_minGapPct   = input.float(1.0,  "Min Gap %",                    minval=0.1, step=0.1,  group=G_F)
i_minRelVol   = input.float(1.5,  "Min Relative Volume (daily)",  minval=0.5, step=0.1,  group=G_F)
i_htfLook     = input.int(20,     "HTF Resistance Lookback (days)", minval=5,             group=G_F)
i_trendPer    = input.int(50,     "Trend EMA Period (daily)",     minval=10,              group=G_F)
i_resistBuf   = input.float(1.0,  "Resistance Buffer %",          minval=0.0, step=0.1,  group=G_F)
i_consolidMul = input.float(0.75, "Tight Prior Day (×ATR)",       minval=0.1, step=0.05, group=G_F)
i_reqTrend    = input.bool(true,  "Require Trend Alignment",                              group=G_F)
i_reqTight    = input.bool(true,  "Require Tight Prior Day",                              group=G_F)
i_blockResist = input.bool(true,  "Block Longs Into Resistance",                          group=G_F)

var G_C = "Classification"
i_confirmBars = input.int(6,      "Confirmation Window (bars)",   minval=2, maxval=30,    group=G_C)
i_exhRelVol   = input.float(2.5,  "Exhaustion Min RelVol",        minval=1.0, step=0.1,  group=G_C)
i_exhATRmul   = input.float(1.5,  "Exhaustion Min ATR Mult",      minval=0.5, step=0.1,  group=G_C)
i_latePct     = input.float(15.0, "Late Trend Min % from 200EMA", minval=5.0,            group=G_C)

var G_R = "Risk / Reward"
i_tp1r        = input.float(1.5,  "TP1 (R)",                      minval=0.5, step=0.25, group=G_R)
i_tp2r        = input.float(3.0,  "TP2 (R)",                      minval=1.0, step=0.5,  group=G_R)
i_lineLen     = input.int(30,     "Level Line Length (bars)",      minval=5,              group=G_R)

var G_D = "Display"
txt_sz_str    = input.string("Normal", "Text Size", options=["Tiny","Small","Normal","Large","Huge"], group=G_D)
i_showFiltered = input.bool(false, "Show Filtered-Out Gaps",                              group=G_D)
i_showVWAP    = input.bool(true,  "Show VWAP",                                            group=G_D)
i_showZone    = input.bool(true,  "Show Gap Zone Box",                                    group=G_D)

// ── TEXT SIZE ─────────────────────────────────────────────────────────────────
string txt_sz = txt_sz_str == "Tiny" ? size.tiny : txt_sz_str == "Small" ? size.small : txt_sz_str == "Large" ? size.large : txt_sz_str == "Huge" ? size.huge : size.normal

// ── DAILY DATA VIA REQUEST.SECURITY ──────────────────────────────────────────
// Pull prior-day values — lookahead_on so first intraday bar sees yesterday's close
d_close   = request.security(syminfo.tickerid, "D", close[1],                lookahead=barmerge.lookahead_on)
d_high    = request.security(syminfo.tickerid, "D", high[1],                 lookahead=barmerge.lookahead_on)
d_low     = request.security(syminfo.tickerid, "D", low[1],                  lookahead=barmerge.lookahead_on)
d_volume  = request.security(syminfo.tickerid, "D", volume,                  lookahead=barmerge.lookahead_on)
d_vol20   = request.security(syminfo.tickerid, "D", ta.sma(volume, 20)[1],   lookahead=barmerge.lookahead_on)
d_atr14   = request.security(syminfo.tickerid, "D", ta.atr(14)[1],           lookahead=barmerge.lookahead_on)
d_ema50   = request.security(syminfo.tickerid, "D", ta.ema(close, 50)[1],    lookahead=barmerge.lookahead_on)
d_ema200  = request.security(syminfo.tickerid, "D", ta.ema(close, 200)[1],   lookahead=barmerge.lookahead_on)
d_htfHigh = request.security(syminfo.tickerid, "D", ta.highest(high, 20)[1], lookahead=barmerge.lookahead_on)

// ── SESSION & INTRADAY TRACKING ───────────────────────────────────────────────
isNewDay    = ta.change(time("D")) != 0
isMarket    = session.ismarket

// First bar of the regular session each day
isSessionOpen = isNewDay and isMarket

// Track bar count within the session (1 = open bar)
var int sessionBar = 0
if isSessionOpen
    sessionBar := 1
else if isMarket
    sessionBar += 1

// Capture the open of the session (gap day open price)
var float dayOpen     = na
var float prevClose   = na
if isSessionOpen
    dayOpen   := open
    prevClose := d_close

// ── GAP METRICS (computed once at session open, held for the day) ─────────────
var float gapAmt    = na
var float gapPct    = na
var float gapVsATR  = na
var float dayRelVol = na
var bool  gapIsUp   = false
var bool  gapIsDown = false

if isSessionOpen
    gapAmt    := math.abs(open - d_close)
    gapPct    := gapAmt / math.max(d_close, 0.001) * 100
    gapVsATR  := gapAmt / math.max(d_atr14, 0.001)
    dayRelVol := d_volume / math.max(d_vol20, 1)
    gapIsUp   := open > d_close
    gapIsDown := open < d_close

// ── PRE-FILTERS ───────────────────────────────────────────────────────────────
var bool f_size    = false
var bool f_vol     = false
var bool f_trend   = false
var bool f_resist  = false
var bool f_tight   = false
var bool passFilter = false

if isSessionOpen
    f_size   := gapPct >= i_minGapPct
    f_vol    := dayRelVol >= i_minRelVol
    f_trend  := not i_reqTrend or (gapIsUp and d_close > d_ema50) or (gapIsDown and d_close < d_ema50)
    intoRes  = gapIsUp and open >= d_htfHigh * (1 - i_resistBuf / 100)
    f_resist := not i_blockResist or gapIsDown or not intoRes
    priorRng = d_high - d_low
    f_tight  := not i_reqTight or priorRng <= d_atr14 * i_consolidMul
    passFilter := f_size and f_vol and f_trend and f_resist and f_tight

// Hold filter result for the full session
var bool sessionPassFilter = false
if isSessionOpen
    sessionPassFilter := passFilter

// ── VWAP ──────────────────────────────────────────────────────────────────────
vwap = ta.vwap(hlc3)

// ── 30-MINUTE CONFIRMATION WINDOW ─────────────────────────────────────────────
// At bar i_confirmBars: is price still holding the gap direction vs gap open?
isConfirmBar = isMarket and sessionBar == i_confirmBars

// A gap-up holds if price is above the day open at confirmation
// A gap-up fails if price has dropped back below the day open
var bool gapHeld   = false  // held direction through confirmation window
var bool gapFailed = false  // reversed through confirmation window

if isConfirmBar and sessionPassFilter
    if gapIsUp
        gapHeld   := close > dayOpen and close > vwap  // still above open & VWAP
        gapFailed := close < dayOpen or close < vwap   // gave back the gap
    else if gapIsDown
        gapHeld   := close < dayOpen and close < vwap
        gapFailed := close > dayOpen or close > vwap

// ── CLASSIFICATION (set at confirmation bar) ───────────────────────────────────
var bool isExhaustion = false
var bool isBreakaway  = false
var bool isRunaway    = false

if isConfirmBar and sessionPassFilter
    distFrom200  = math.abs(d_close - d_ema200) / math.max(d_ema200, 0.001) * 100
    // Exhaustion: climactic volume OR large gap AND late in trend AND gap failed
    isExhaustion := gapFailed and (dayRelVol >= i_exhRelVol or gapVsATR >= i_exhATRmul)
    // Breakaway: held direction AND breaks prior N-day structure
    isBreakaway  := gapHeld and ((gapIsUp and dayOpen > d_htfHigh) or (gapIsDown and dayOpen < request.security(syminfo.tickerid, "D", ta.lowest(low, i_htfLook)[1], lookahead=barmerge.lookahead_on)))
    // Runaway: held direction, mid-trend, not a structure break
    isRunaway    := gapHeld and not isBreakaway

// Hold classification for the session
var bool sessExhaustion = false
var bool sessBreakaway  = false
var bool sessRunaway    = false
if isConfirmBar
    sessExhaustion := isExhaustion
    sessBreakaway  := isBreakaway
    sessRunaway    := isRunaway

// ── ENTRY SIGNALS ─────────────────────────────────────────────────────────────
// Breakaway / Runaway long: first bar that pulls back to VWAP after confirmation
var bool vwapEntryArmed = false
if isConfirmBar and (sessBreakaway or sessRunaway) and gapIsUp
    vwapEntryArmed := true
if isConfirmBar and (sessBreakaway or sessRunaway) and gapIsDown
    vwapEntryArmed := true
if isNewDay
    vwapEntryArmed := false

// Long entry: first pullback to touch VWAP after confirmation, then close back above
longPullback = vwapEntryArmed and gapIsUp and sessionBar > i_confirmBars and
     low <= vwap and close > vwap

// Short entry (gap-down): first bounce to VWAP then close back below
shortPullback = vwapEntryArmed and gapIsDown and sessionBar > i_confirmBars and
     high >= vwap and close < vwap

// Exhaustion fade: gap-up that failed — short when price closes below VWAP
exhaustFadeShort = isConfirmBar and sessExhaustion and gapIsUp   and close < vwap
exhaustFadeLong  = isConfirmBar and sessExhaustion and gapIsDown and close > vwap

// Disarm after first signal per session
var bool entryFired = false
if isNewDay
    entryFired := false
if longPullback or shortPullback or exhaustFadeShort or exhaustFadeLong
    entryFired := true

longSignal  = (longPullback  or exhaustFadeLong)  and not entryFired[1]
shortSignal = (shortPullback or exhaustFadeShort) and not entryFired[1]

// ── STOP & TARGET LEVELS ──────────────────────────────────────────────────────
entryPrice = close

// Long stop: below the day open (gap low) — if it breaks the gap, thesis is dead
stopLong  = dayOpen - (dayOpen - prevClose) * 0.5  // midpoint of gap zone
riskLong  = math.max(entryPrice - stopLong, 0.001)
tp1Long   = entryPrice + riskLong * i_tp1r
tp2Long   = entryPrice + riskLong * i_tp2r

// Short stop: above the day open (gap high)
stopShort  = dayOpen + (prevClose - dayOpen) * 0.5
riskShort  = math.max(stopShort - entryPrice, 0.001)
tp1Short   = entryPrice - riskShort * i_tp1r
tp2Short   = entryPrice - riskShort * i_tp2r

// ── UDFs ──────────────────────────────────────────────────────────────────────
drawLevels(entry, stp, tp1, tp2, col) =>
    x2 = bar_index + i_lineLen
    line.new(bar_index, entry, x2, entry, color=color.gray,  style=line.style_dotted, width=1)
    line.new(bar_index, stp,   x2, stp,   color=color.red,   style=line.style_dashed, width=1)
    line.new(bar_index, tp1,   x2, tp1,   color=col,         style=line.style_solid,  width=1)
    line.new(bar_index, tp2,   x2, tp2,   color=col,         style=line.style_solid,  width=2)

buildLabel(gType, isLong, entry, stp, tp1, tp2, bgCol) =>
    stopLbl = isLong ? "Stop:  " : "Stop:  "
    dir     = isLong ? " | LONG ↑" : " | SHORT ↓"
    txt = gType + dir + "\n" +
          "Entry:  " + str.tostring(entry, "#.##") + "\n" +
          stopLbl + str.tostring(stp, "#.##") + "\n" +
          "TP1 (" + str.tostring(i_tp1r, "#.#") + "R):  " + str.tostring(tp1, "#.##") + "\n" +
          "TP2 (" + str.tostring(i_tp2r, "#.#") + "R):  " + str.tostring(tp2, "#.##") + "\n" +
          "RelVol: " + str.tostring(dayRelVol, "#.##") + "×   Gap: " + str.tostring(gapPct, "#.##") + "%"
    yPos = isLong ? low  : high
    styl = isLong ? label.style_label_up : label.style_label_down
    label.new(bar_index, yPos, text=txt, style=styl, color=bgCol, textcolor=color.white, size=txt_sz)

drawZone(isBullish) =>
    col  = isBullish ? color.new(color.green, 85) : color.new(color.red, 85)
    bCol = isBullish ? color.new(color.green, 50) : color.new(color.red, 50)
    gapTop = math.max(dayOpen, prevClose)
    gapBot = math.min(dayOpen, prevClose)
    box.new(bar_index, gapTop, bar_index + i_lineLen, gapBot, bgcolor=col, border_color=bCol)

// ── RENDER CLASSIFICATION LABEL AT CONFIRMATION BAR ───────────────────────────
if isConfirmBar and sessionPassFilter
    gType  = sessExhaustion ? "EXHAUSTION" : sessBreakaway ? "BREAKAWAY" : sessRunaway ? "RUNAWAY" : "GAP"
    bgCol  = sessExhaustion ? color.new(color.red, 20) : sessBreakaway ? color.new(color.green, 20) : color.new(color.teal, 20)
    yPos   = gapIsUp ? high : low
    styl   = gapIsUp ? label.style_label_down : label.style_label_up
    label.new(bar_index, yPos,
         text=gType + "\n" + "RelVol: " + str.tostring(dayRelVol, "#.##") + "×\nGap: " + str.tostring(gapPct, "#.##") + "%",
         style=styl, color=bgCol, textcolor=color.white, size=txt_sz)
    if i_showZone
        drawZone(gapIsUp)

// Filtered-out label at open bar
if isSessionOpen and f_size and f_vol and not sessionPassFilter and i_showFiltered
    reason = not f_trend ? "(trend)" : not f_resist ? "(resist)" : not f_tight ? "(not tight)" : "(other)"
    label.new(bar_index, gapIsUp ? high : low, "FILTERED\n" + reason,
         style=gapIsUp ? label.style_label_down : label.style_label_up,
         color=color.new(color.gray, 50), textcolor=color.white, size=txt_sz)

// ── RENDER ENTRY SIGNALS ──────────────────────────────────────────────────────
if longSignal and longPullback
    drawLevels(entryPrice, stopLong, tp1Long, tp2Long, color.lime)
    buildLabel(sessBreakaway ? "BREAKAWAY" : "RUNAWAY", true, entryPrice, stopLong, tp1Long, tp2Long, color.new(color.green, 15))

if longSignal and exhaustFadeLong
    drawLevels(entryPrice, stopLong, tp1Long, tp2Long, color.orange)
    buildLabel("EXHAUSTION FADE ↑", true, entryPrice, stopLong, tp1Long, tp2Long, color.new(color.orange, 15))

if shortSignal and shortPullback
    drawLevels(entryPrice, stopShort, tp1Short, tp2Short, color.maroon)
    buildLabel(sessBreakaway ? "BREAKAWAY" : "RUNAWAY", false, entryPrice, stopShort, tp1Short, tp2Short, color.new(color.maroon, 15))

if shortSignal and exhaustFadeShort
    drawLevels(entryPrice, stopShort, tp1Short, tp2Short, color.red)
    buildLabel("EXHAUSTION FADE ↓", false, entryPrice, stopShort, tp1Short, tp2Short, color.new(color.red, 15))

// ── PLOTSHAPES ────────────────────────────────────────────────────────────────
plotshape(longSignal,  title="Long Entry",  style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.normal)
plotshape(shortSignal, title="Short Entry", style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.normal)

// ── VWAP PLOT ─────────────────────────────────────────────────────────────────
plot(i_showVWAP and isMarket ? vwap : na, title="VWAP", color=color.new(color.blue, 20), linewidth=2)

// ── GAP OPEN LINE (day open reference) ────────────────────────────────────────
plot(isMarket ? dayOpen : na, title="Day Open", color=color.new(color.yellow, 40), linewidth=1, style=plot.style_circles)
